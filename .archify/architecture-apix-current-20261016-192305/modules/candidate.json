  "cards": [
    {
      "dot": "cyan",
      "title": "这张图表示装配关系",
      "items": [
        "control-plane 共享 Store，并通过依赖注入连接各模块；不是每个模块都直接 import 彼此。",
        "assistant-loop → 宿主 execute → coordinator，是复杂任务委派的调用链。"
      ]
    },
    {
      "dot": "emerald",
      "title": "协作内部依赖",
      "items": [
        "coordinator 用 apix-agent 生成架构与计划，再由 architecture 验证并冻结模块边界。",
        "scheduling 筛选候选，task-scheduler 等待前置任务 accepted，再经宿主启动 CLI。",
        "autonomy 请求宿主运行验收，并通过 coordinator → apix-agent 审查；失败时请求恢复或改派任务。"
      ]
    },
    {
      "dot": "amber",
      "title": "共享不是无限共享",
      "items": [
        "主会话有项目笔记与摘要，协作另有事件记忆和员工上下文。",
        "员工按任务与运行凭据访问 mailbox；第三方 CLI 需要主动轮询才能在运行中收到消息。"
      ]
    }
  ]
