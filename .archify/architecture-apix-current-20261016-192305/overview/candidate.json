  "cards": [
    {
      "dot": "cyan",
      "title": "ApiX 的定位",
      "items": [
        "主循环由 ApiX 宿主实现，直接调用配置的模型 API。",
        "Pi、Codex、Claude 等均为可选执行 Agent；不需要 Pi 才能对话。"
      ]
    },
    {
      "dot": "violet",
      "title": "两层循环",
      "items": [
        "主循环用 delegate 进入协作子流程，并进入 waiting_agents。",
        "协作调度和质量监督由独立定时器与任务事件推进；完成后回到主循环。"
      ]
    },
    {
      "dot": "amber",
      "title": "状态与边界",
      "items": [
        "SQLite 保存会话、事件、项目记忆、权限、预算、契约与验收证据。",
        "已验收表示托管工作区交付已冻结；不代表已合并原分支或推送 GitHub。",
        "主循环工具是固定目录，当前不包含通用 MCP 调用工具。"
      ]
    }
  ]
