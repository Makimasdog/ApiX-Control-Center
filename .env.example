# 阿里百炼：密钥仅放在本地 .env，勿提交。
ali_url=https://dashscope.aliyuncs.com/compatible-mode/v1
ali_api_key=
ali_model_name=
# Pi 已在 PATH 中时无需填写；否则填写真实 CLI 的绝对入口路径。
# APIX_PI_ENTRY=C:/path/to/pi-coding-agent/dist/cli.js
# 管理者可单独指定入口；必须是存在的文件，不填 pi.cmd/目录/命令名。
# APIX_MANAGER_PI_ENTRY=C:/path/to/pi-coding-agent/dist/cli.js
