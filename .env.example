# 阿里百炼：密钥仅放在本地 .env，勿提交。
ali_url=https://dashscope.aliyuncs.com/compatible-mode/v1
ali_api_key=
ali_model_name=
deepseek_url=https://api.deepseek.cn/v1/chat/completions
DEEPSEEK_API_KEY=
deepseek_model_name=deepseek-v4.1-flash

# 可选 Pi 执行员工：已在 PATH 中时无需填写；否则填写真实 CLI 的绝对入口路径。
# APIX_PI_ENTRY=C:/path/to/pi-coding-agent/dist/cli.js
# ApiX 管理者直接使用界面配置的模型 API，不需要 Pi；APIX_MANAGER_PI_ENTRY 已停用。
# 主循环声明的上下文窗口，默认 32768 Token；请勿超过所用模型的实际窗口。
# 使用 UTF-8 字节估算输入占用，并预留输出空间，不代表精确 Token 计费。
# APIX_ASSISTANT_CONTEXT_TOKENS=32768

# 独立 Gateway 的可选外部消息账号，详见 docs/个人助手多平台消息适配.md。
# APIX_MESSAGE_CHANNELS=[]
# APIX_CHANNEL_WECHAT_TOKEN=
# APIX_CHANNEL_TELEGRAM_TOKEN=
# APIX_CHANNEL_DISCORD_TOKEN=

# 可选的 AgentSkill 网页搜索密钥。启用网页搜索技能后，查询会发送至 Brave。
# APIX_SKILL_BRAVE_KEY=
